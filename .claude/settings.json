{
  "permissions": {
    "allow": [
      "Bash(php artisan test*)",
      "Bash(php artisan migrate*)",
      "Bash(php artisan tinker*)",
      "Bash(composer install)",
      "Bash(composer require*)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npx playwright*)",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh issue*)",
      "Bash(gh pr*)"
    ],
    "deny": [
      "Bash(php artisan migrate --force*)",
      "Bash(php artisan db:seed --force*)",
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[NEXVARY GATE] Before declaring done: verify php artisan test passes, CI is green, and no dd()/dump() remain in production code.'"
          }
        ]
      }
    ]
  }
}
