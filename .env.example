# =============================================================================
# NEXVARY CX Cloud — Environment Configuration
# Copy to .env and fill in your values. Never commit .env to version control.
# =============================================================================

APP_NAME="NEXVARY CX Cloud"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexvary_cx
DB_USERNAME=nexvary_cx
DB_PASSWORD=

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# ── Cache / Queue / Session ───────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── FreeSWITCH ESL ────────────────────────────────────────────────────────────
FREESWITCH_FUSIONPBX=false
FREESWITCH_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon
FREESWITCH_SIP_HOST=127.0.0.1
FREESWITCH_SIP_PORT=5060
FREESWITCH_TLS_PORT=5061
FREESWITCH_CONF_DIR=/etc/freeswitch
FREESWITCH_LOG_DIR=/var/log/freeswitch

# ── WebRTC Bridge ─────────────────────────────────────────────────────────────
RTC_BRIDGE_URL=ws://127.0.0.1:3000
RTC_BRIDGE_TOKEN=
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USER=
TURN_CREDENTIAL=

# ── Telnyx ───────────────────────────────────────────────────────────────────
TELNYX_API_KEY=
TELNYX_API_SECRET=
TELNYX_PUBLIC_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_SECRET=
TELNYX_SIP_TRUNK_ID=

# ── SIP Provider (Generic) ────────────────────────────────────────────────────
SIP_PROVIDER_HOST=
SIP_PROVIDER_PORT=5060
SIP_PROVIDER_REALM=
SIP_PROVIDER_USERNAME=
SIP_PROVIDER_PASSWORD=
SIP_PROVIDER_TRANSPORT=udp

# ── Email (SMTP Outbound) ─────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ── IMAP (Email Reception) ────────────────────────────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_ENCRYPTION=ssl
IMAP_INBOX=INBOX

# ── Voice AI ──────────────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_DEFAULT_MODEL=gpt-4o
TTS_ENGINE=openai
STT_ENGINE=openai
VOICE_AI_ENABLED=false

# ── Storage ───────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
RECORDING_STORAGE=local
RECORDING_RETENTION_DAYS=90

# ── Security ──────────────────────────────────────────────────────────────────
MFA_ENABLED=true
SESSION_MAX_ATTEMPTS=5
ADMIN_NETWORK_ALLOW=
TOLL_FRAUD_PROTECTION=true
MAX_INTERNATIONAL_CALLS=10
MAX_CONCURRENT_CALLS=50

# ── Installation ──────────────────────────────────────────────────────────────
NEXVARY_INSTALLED=false
NEXVARY_INSTALL_SECRET=
NEXVARY_VERSION=1.0.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ── Broadcasting ──────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=nexvary-cx
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
