# NEXVARY CX Cloud — Docker environment template
# This file is used by deploy/docker-install.sh to generate deploy/.env
# Do NOT commit deploy/.env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="NEXVARY CX Cloud"
APP_ENV=production
APP_KEY=                          # generated by installer
APP_DEBUG=false
APP_URL=https://DOMAIN_PLACEHOLDER
APP_TIMEZONE=UTC
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_VERSION=1.0.0

# ── Database (service name = postgres, resolved by Docker DNS) ────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nexvary_cx
DB_USERNAME=nexvary_cx
DB_PASSWORD=                      # generated by installer

# ── Redis (service name = redis, resolved by Docker DNS) ─────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                   # generated by installer
REDIS_DB=0

# ── Cache / Queue / Session ───────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── FreeSWITCH (host.docker.internal = host, host-network FreeSWITCH) ─────────
FREESWITCH_HOST=host.docker.internal
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=          # generated by installer — never use default ClueCon
FREESWITCH_SIP_HOST=DOMAIN_PLACEHOLDER
FREESWITCH_SIP_PORT=5060
FREESWITCH_TLS_PORT=5061
FREESWITCH_CONF_DIR=/etc/freeswitch
FREESWITCH_LOG_DIR=/var/log/freeswitch

# ── WebRTC Bridge (service name = rtc-bridge) ─────────────────────────────────
RTC_BRIDGE_URL=ws://rtc-bridge:3000
RTC_BRIDGE_TOKEN=                 # generated by installer
RTC_BRIDGE_PORT=3000
RTC_BIND_ADDRESS=0.0.0.0
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USER=
TURN_CREDENTIAL=

# ── Nginx HTTP port (loopback for host Nginx proxy) ───────────────────────────
NEXVARY_HTTP_PORT=8080

# ── DOMAIN (used by FreeSWITCH and app) ──────────────────────────────────────
DOMAIN=DOMAIN_PLACEHOLDER

# ── Broadcasting (Laravel Reverb) ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=nexvary-cx
REVERB_APP_KEY=                   # generated by installer
REVERB_APP_SECRET=                # generated by installer
REVERB_HOST=rtc-bridge
REVERB_PORT=3000
REVERB_SCHEME=http

# ── Installation ──────────────────────────────────────────────────────────────
NEXVARY_INSTALLED=false
NEXVARY_INSTALL_SECRET=           # generated by installer
NEXVARY_VERSION=1.0.0

# ── Security ──────────────────────────────────────────────────────────────────
MFA_ENABLED=true
SESSION_MAX_ATTEMPTS=5
TOLL_FRAUD_PROTECTION=true
MAX_CONCURRENT_CALLS=50
MAX_INTERNATIONAL_CALLS=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Mail (configure after installation) ──────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@DOMAIN_PLACEHOLDER
MAIL_FROM_NAME="NEXVARY CX Cloud"
