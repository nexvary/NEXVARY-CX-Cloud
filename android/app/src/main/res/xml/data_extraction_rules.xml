<?xml version="1.0" encoding="utf-8"?>
<!--
    Android data extraction rules (API 31+, supersedes backup_rules.xml for
    cloud backup and device-to-device transfer).
    Credential files must never be transferred — they contain device-specific
    tokens that are only valid for the original installation.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nexvary_credentials.xml" />
        <exclude domain="sharedpref" path="nexvary_credentials_plain.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nexvary_credentials.xml" />
        <exclude domain="sharedpref" path="nexvary_credentials_plain.xml" />
    </device-transfer>
</data-extraction-rules>
